# Backend
DATABASE_URL=postgresql+psycopg2://finsight:finsight_dev_password@localhost:5432/finsight
# Leave DATABASE_URL unset to use local SQLite (./finsight.db) for quick dev/tests
SECRET_KEY=change-me-in-production-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
# LLM (optional — deterministic fallback works without it)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
